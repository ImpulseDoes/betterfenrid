{
  "name": "better-fenrid-desktop",
  "productName": "Better Fenrid",
  "version": "0.1.0",
  "description": "Fenrid in its own window, with Better Fenrid built in.",
  "author": "impulsedoes",
  "license": "MIT",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "mod": "npm --prefix .. run build",
    "start": "npm run mod && npm run helper && electron .",
    "dev": "npm run helper && electron . --dev",
    "dist": "npm run mod && npm run helper && node scripts/dist.cjs",
    "dist:portable": "npm run mod && npm run helper && node scripts/dist.cjs portable",
    "helper": "node scripts/build-helper.cjs"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.impulsedoes.betterfenrid",
    "productName": "Better Fenrid",
    "icon": "assets/icon.png",
    "directories": {
      "output": "out"
    },
    "files": [
      "src/**",
      "!src/media/*.cs",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "src/media/media-helper.exe"
    ],
    "extraResources": [
      {
        "from": "../dist/betterfenrid.js",
        "to": "betterfenrid.js"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Better Fenrid",
      "differentialPackage": false
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "pl"
    ],
    "afterPack": "./scripts/after-pack.cjs"
  }
}